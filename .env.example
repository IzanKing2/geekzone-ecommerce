# Variables de Docker Compose (docker-compose.yml). Copia este fichero a `.env` en la raíz del repo.
# La app Laravel tiene su propio geekzone/.env (copia de geekzone/.env.example).
#
# Si no creas `.env`, se usan los valores por defecto de desarrollo del docker-compose.yml.
# En cualquier otro entorno cambia SIEMPRE estas contraseñas.
#
# DB_PASSWORD debe coincidir con DB_PASSWORD de geekzone/.env.
#
# OJO: MySQL solo aplica estas contraseñas al CREAR el volumen de datos. Si ya tienes
# una base creada, cambiar el .env no cambia su contraseña (borra el volumen con
# `docker-compose down -v` o cámbiala dentro de MySQL).

DB_DATABASE=geekzone
DB_USERNAME=geekzone_user
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_clave_root
