# ——————————————————————————————————————————————————————————————————————
# .gitignore para GeekZone
# ——————————————————————————————————————————————————————————————————————
# Lista de archivos y carpetas que Git debe IGNORAR.
# Estos archivos NO se subirán al repositorio porque:
# - Contienen datos sensibles (.env, contraseñas)
# - Son generados automáticamente (vendor, node_modules)
# - Son específicos de cada máquina (logs, caché)
# ——————————————————————————————————————————————————————————————————————

# ———— Archivos sensibles ————————————————————————
.env
*.env.local

# ———— Dependencias (se regeneran con composer/npm install) ————————————————————————
/src/vendor/
/src/node_modules/

# ———— Archivos de caché y logs de Laravel ————————————————————————
/src/storage/logs/*
/src/storage/framework/cache/*
/src/storage/framework/sessions/*
/src/storage/framework/views/*
/src/bootstrap/cache/*

# ———— Archivos del sistema operativo ————————————————————————
.DS_Store
Thumbs.db
desktop.ini

# ———— Archivos de IDEs ————————————————————————
.idea/
.vscode/
*.swp
*.swo

# ———— Docker ————————————————————————
# Los volúmenes de datos de MySQL se gestionan por Docker, no por Git
geekzone-db-data/
