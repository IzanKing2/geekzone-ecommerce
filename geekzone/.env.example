APP_NAME=GeekZone
# Esta plantilla es para DESARROLLO en Docker (local). En producción usa APP_ENV=production y APP_DEBUG=false.
# Con APP_ENV=local, `migrate --seed` crea admin@geekzone.com / admin123 y user@geekzone.com / user123.
# Fuera de local el seeder NO crea usuarios conocidos: define ADMIN_EMAIL y ADMIN_PASSWORD para crear el admin.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Orígenes que pueden llamar a la API desde otro sitio (separados por comas). Por defecto solo APP_URL.
# CORS_ALLOWED_ORIGINS=

# Administrador inicial para entornos que no son local (el seeder no lo crea si faltan)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=geekzone
DB_USERNAME=geekzone_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Swagger — nunca generar automáticamente en producción
L5_SWAGGER_GENERATE_ALWAYS=false

# JWT — ejecutar `php artisan jwt:secret` para generar el valor
JWT_SECRET=
JWT_ALGO=HS256
# JWT_TTL=60
# JWT_BLACKLIST_ENABLED=true

# Google reCAPTCHA v2
# Activo por defecto; la API verifica el captcha en servidor (login y registro).
# RECAPTCHA_ENABLED=false  -> solo para local/pruebas con Bruno o Postman.
# Claves de test de Google (siempre validan): site 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI / secret 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
